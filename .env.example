# Names only. Put real values in .env.local (git-ignored) or your host's env settings.

# Supabase. Copy the publishable key and a secret key from
# Settings > API Keys > "Publishable and secret API keys", then deactivate the
# legacy anon and service_role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A Supabase secret key (sb_secret_...). Server only: never expose it to the
# browser. Used by the step-complete webhook and pnpm registry:sync; it acts as
# the service_role Postgres role, which cannot write approvals.
SUPABASE_SECRET_KEY=

# The single Supabase Auth user ID allowed into the app.
DENKORE_OWNER_USER_ID=

# Shared HMAC secret for POST /api/webhooks/step-complete.
STEP_WEBHOOK_SECRET=

# Local database (pnpm db:start). Put these in .env.local instead of the values above
# to run against the local Supabase stack, never production. Get the two keys from
# `pnpm exec supabase status`. The owner id is the user created by supabase/seed.sql.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local publishable key>
# SUPABASE_SECRET_KEY=<local secret key>
# DENKORE_OWNER_USER_ID=d3c0de00-0000-4000-8000-000000000001
#
# Local GitHub sign-in: these two go in supabase/.env (git-ignored), read by
# supabase/config.toml, not by the app.
# GITHUB_LOCAL_CLIENT_ID=
# GITHUB_LOCAL_SECRET=
